# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# 1. Install shared devDeps (typescript) and compile shared
COPY shared/package.json ./shared/
RUN npm install --include=dev --prefix ./shared

COPY shared/ ./shared/
RUN npm run --prefix ./shared build

# 2. Install ALL backend deps (devDeps needed for tsc)
COPY backend/package.json backend/package-lock.json ./backend/
RUN npm ci --prefix ./backend

# 3. Compile backend — run tsc directly so we skip the redundant shared rebuild
COPY backend/src/      ./backend/src/
COPY backend/tsconfig.json ./backend/
RUN cd backend && npx tsc

# ── Production stage ─────────────────────────────────────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app

# shared/dist must be accessible at runtime — backend imports via relative path
# e.g. backend/dist/services/time.service.js -> ../../../shared/dist/time.js
COPY --from=builder /app/shared/dist/ ./shared/dist/

# Compiled backend
COPY --from=builder /app/backend/dist/ ./backend/dist/

# Production-only deps
COPY backend/package.json backend/package-lock.json ./backend/
RUN npm ci --omit=dev --prefix ./backend

EXPOSE 3001
CMD ["node", "/app/backend/dist/server.js"]
