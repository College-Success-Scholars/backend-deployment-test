# Supabase — public keys (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# Backend URL used by server-side Next.js fetch (not exposed to browser)
# Railway: set to your Railway backend service URL, e.g. https://backend.railway.app
# Vercel experimentalServices: set to https://<your-app>.vercel.app/_/backend
# Dev default: http://localhost:3001
BACKEND_URL=http://localhost:3001

# Backend URL used by client-side (browser) fetch
# Must match BACKEND_URL for same-origin deploys (Vercel experimentalServices)
# Set to the public backend URL for split deploys (Railway backend + Vercel frontend)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
