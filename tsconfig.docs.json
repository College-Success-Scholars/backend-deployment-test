{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["frontend/*"]
    },
    "types": ["node"]
  },
  "include": [
    "shared/**/*.ts",
    "backend/src/**/*.ts",
    "frontend/lib/**/*.ts",
    "frontend/lib/**/*.tsx",
    "frontend/components/personal/utils.ts",
    "frontend/components/mentee-monitoring/utils.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "backend/src/tests/**",
    "frontend/legacy/**",
    "shared/dist/**",
    "backend/dist/**"
  ]
}
