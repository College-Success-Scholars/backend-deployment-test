{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "shared/auth.ts",
    "shared/time.ts",
    "shared/time-types.ts",
    "shared/time-config.ts",
    "shared/eastern-time.ts",
    "shared/campus-calendar.ts",
    "backend/src/controllers",
    "backend/src/services",
    "backend/src/middleware",
    "backend/src/models",
    "backend/src/supabase/client.ts",
    "frontend/lib",
    "frontend/components/personal/utils.ts",
    "frontend/components/mentee-monitoring/utils.ts"
  ],
  "entryPointStrategy": "expand",
  "tsconfig": "tsconfig.docs.json",
  "out": "docs/reference/api",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "exclude": [
    "**/*.{test,spec}.ts",
    "**/node_modules/**",
    "backend/src/tests/**",
    "backend/src/supabase/database.types.ts",
    "frontend/legacy/**",
    "frontend/components/ui/**"
  ],
  "blockTags": [
    "@file",
    "@module",
    "@param",
    "@returns",
    "@return",
    "@throws",
    "@deprecated",
    "@example",
    "@see",
    "@since",
    "@remarks",
    "@update"
  ],
  "excludePrivate": true,
  "excludeExternals": true,
  "excludeInternal": true,
  "skipErrorChecking": true,
  "githubPages": false,
  "sourceLinkTemplate": "https://github.com/College-Success-Scholars/css-atlas-v2/blob/develop/{path}#L{line}",
  "gitRevision": "develop",
  "name": "CSS Atlas API",
  "includeVersion": false,
  "categorizeByGroup": true,
  "sort": ["source-order"],
  "outputs": [
    {
      "name": "markdown",
      "path": "docs/reference/api"
    }
  ]
}
